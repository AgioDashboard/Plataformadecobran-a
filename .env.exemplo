# Modelo das variaveis que o Worker le em backend/src/config.ts.
# Este arquivo e versionado: NUNCA preencha um valor aqui.
#
# Em producao nada disso vem de arquivo — cada segredo e gravado com
# `wrangler secret put NOME` e fica so no Cloudflare. Localmente, copie
# para backend/.dev.vars (ignorado pelo git) e preencha la.
#
# A Voll saiu do projeto na Fase 2: o envio usa a Meta Cloud API direta.
# A Cobmais tambem nao tem integracao por API — a planilha e exportada a
# mao e importada por comando no endpoint /api/importar — entao nao ha
# credencial dela aqui.

# --- Obrigatorias: sem qualquer uma delas o Worker recusa subir ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
ANTHROPIC_API_KEY=
PAINEL_TOKEN=

# --- Opcionais ---
# AMBIENTE: 'teste' quando ausente.
AMBIENTE=
# DESTINATARIOS_TESTE: allowlist separada por virgula. Vazia bloqueia todo
# envio, que e o modo de falha desejado enquanto a operacao esta em teste.
DESTINATARIOS_TESTE=
